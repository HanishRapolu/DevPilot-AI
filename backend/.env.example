# Copy this file to .env and edit locally. Never share or commit .env.
# REQUIRED for task persistence: paste your Atlas connection URI below.
# Replace the database password placeholder; percent-encode reserved password characters.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=devpilot
# Local dashboard authentication. Generate a random value; never expose it in VITE_*.
DASHBOARD_API_TOKEN=
# REQUIRED only for live LLM calls. Keep empty until configured.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STRUCTURED_OUTPUTS=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
CORS_ORIGINS=["http://localhost:5173"]

# Phase 2: one authorized repository; token is optional for public reads.
# Fine-grained token: Issues read, Contents read/write, Pull requests read/write.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
# Absolute path to a clean local Git checkout with matching origin.
REPOSITORY_SOURCE=
# JSON array of exact existing relative files that may be edited.
REPOSITORY_ALLOWED_FILES=[]
# Filled using the path printed by python -m scripts.prepare_workspace.
MCP_WORKSPACE=
MCP_TIMEOUT_SECONDS=150
# Local Docker execution settings; no Docker API key is required.
# Build this trusted runner from ../sandbox; do not use the Phase 1 demo image.
SANDBOX_IMAGE=devpilot-python-tests:phase2
SANDBOX_TIMEOUT_SECONDS=60
# Memory (256 MiB), CPUs (1), PIDs (64), and network policy are enforced in code.
